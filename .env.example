# Copie este arquivo para ".env" e preencha os valores.   cp .env.example .env
# O arquivo ".env" NUNCA deve ir para o GitHub (já está no .gitignore).
# Em produção, configure estas variáveis no painel da hospedagem em vez de usar um arquivo.

# ---- Aplicação ----
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Chave secreta para assinar sessões/tokens. Gere uma diferente para cada ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Só preencha se o front-end for servido em OUTRO domínio (origens separadas por vírgula; nunca "*").
CORS_ORIGIN=

# ---- Banco de dados (MySQL) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=eventos_VDA
MYSQL_USER=
MYSQL_PASSWORD=
# Usada pelo Prisma CLI; formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=
# Ajuste ao limite do plano do provedor; o Blueprint gratuito do Render usa 2.
MYSQL_CONNECTION_LIMIT=10
# Muitos bancos hospedados exigem conexão criptografada: use true.
MYSQL_SSL=false

# ---- Supabase Storage (bucket público para capas de eventos) ----
SUPABASE_URL=
# Use a chave service_role/secret somente no servidor. Nunca a exponha no front-end.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_EVENTOS=event-covers

# ---- Administrador inicial (usado somente por `npm run criar:admin`) ----
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
