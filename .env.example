# Copie este arquivo para ".env" e preencha os valores.   cp .env.example .env
# O arquivo ".env" NUNCA deve ir para o GitHub (já está no .gitignore).
# Em produção, configure estas variáveis no painel da hospedagem em vez de usar um arquivo.

# ---- Aplicação ----
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Chave secreta para assinar sessões/tokens. Gere uma diferente para cada ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Só preencha se o front-end for servido em OUTRO domínio (origens separadas por vírgula; nunca "*").
CORS_ORIGIN=

# ---- Banco de dados (MySQL) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=eventos_VDA
MYSQL_USER=
MYSQL_PASSWORD=
# Muitos bancos hospedados exigem conexão criptografada: use true.
MYSQL_SSL=false

# ---- Administrador inicial (usado somente por `npm run criar:admin`) ----
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- E-mail (SMTP do Google / Gmail) — código de verificação e confirmação de inscrição ----
# Use uma "senha de app" (Conta Google > Segurança > Verificação em duas etapas > Senhas de app),
# NUNCA a senha normal da conta. Sem SMTP_USERNAME/SMTP_PASSWORD, em desenvolvimento o e-mail
# não é enviado: o conteúdo (com o código) aparece no console do servidor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Remetente exibido, ex.: Eventos Vale do Aço <seuemail@gmail.com>
SMTP_FROM=
