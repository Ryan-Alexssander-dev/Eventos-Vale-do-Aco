// Schema do Prisma: descreve o banco e o modelo de dados.
// A URL de conexão vem da variável de ambiente DATABASE_URL (.env local ou painel do Render).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  usuario
  organizador
  administrador
}

model User {
  id               Int           @id @default(autoincrement()) @map("id_user") @db.UnsignedInt
  nome             String        @db.VarChar(50)
  email            String        @unique(map: "uq_users_email") @db.VarChar(255)
  senha            String        @db.VarChar(255)
  tipo             TipoUsuario   @default(usuario)
  avatar           String?       @db.VarChar(20)
  emailVerificado  Boolean       @default(false) @map("email_verificado")
  notificacoes     Json?
  cidadesInteresse Json?         @map("cidades_interesse")
  eventos          Evento[]
  eventosSalvos    EventoSalvo[]
  inscricoes       Inscricao[]

  @@map("users")
}

model Company {
  id           Int      @id @default(autoincrement()) @map("id_company") @db.UnsignedInt
  cnpj         String   @unique @db.VarChar(18)
  nomeEmpresa  String   @db.VarChar(100)
  emailEmpresa String   @db.VarChar(255)
  eventos      Evento[]

  @@map("companys")
}

model Evento {
  id            Int           @id @default(autoincrement()) @map("id_event") @db.UnsignedInt
  nomeEvento    String        @db.VarChar(200)
  categoria     String        @db.VarChar(20)
  descricao     String        @db.VarChar(255)
  dataEvento    DateTime      @db.Date
  horaEvento    DateTime      @db.Time(0)
  cidade        String        @db.VarChar(100)
  endereco      String        @db.VarChar(255)
  precoIngresso Decimal       @default(0) @db.Decimal(10, 2)
  qtdIngresso   Int?          @db.UnsignedInt
  link          String?       @db.VarChar(255)
  capa          String?       @db.MediumText
  idUser        Int           @map("id_user") @db.UnsignedInt
  idCompany     Int?          @map("id_company") @db.UnsignedInt
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamp(0)
  user          User          @relation(fields: [idUser], references: [id], onDelete: Restrict, map: "fk_eventos_usuario")
  company       Company?      @relation(fields: [idCompany], references: [id], onDelete: SetNull, map: "fk_eventos_empresa")
  salvos        EventoSalvo[]
  inscricoes    Inscricao[]

  @@index([dataEvento, horaEvento], map: "idx_eventos_data")
  @@map("eventos")
}

model EventoSalvo {
  idUser   Int      @map("id_user") @db.UnsignedInt
  idEvento Int      @map("id_event") @db.UnsignedInt
  salvoEm  DateTime @default(now()) @map("salvo_em") @db.Timestamp(0)
  user     User     @relation(fields: [idUser], references: [id], onDelete: Cascade, map: "fk_eventos_salvos_usuario")
  evento   Evento   @relation(fields: [idEvento], references: [id], onDelete: Cascade, map: "fk_eventos_salvos_evento")

  @@id([idUser, idEvento])
  @@map("eventos_salvos")
}

model Inscricao {
  idUser   Int      @map("id_user") @db.UnsignedInt
  idEvento Int      @map("id_event") @db.UnsignedInt
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamp(0)
  user     User     @relation(fields: [idUser], references: [id], onDelete: Cascade, map: "fk_inscricoes_usuario")
  evento   Evento   @relation(fields: [idEvento], references: [id], onDelete: Cascade, map: "fk_inscricoes_evento")

  @@id([idUser, idEvento])
  @@map("inscricoes")
}
